// Game mode switcher (Classic / Deathmatch / GunGame / ...)
//
// Modes are listed in configs/lan_modes.ini. For each mode <key>:
//   configs/modes/<key>.ini  plugins that make up the mode (copied to
//                            configs/plugins-mode.ini, loaded on next map)
//   configs/modes/<key>.cfg  cvars executed on every map start in that mode
// The active mode is stored in data/lan_mode.txt.
//
// say /mode       admins: switch menu, players: show current mode
// say /votemode   everyone: start a mode vote
// amx_gamemode <key>  admins: switch from console
// amx_gamemodemenu    admins: switch menu (also in amxmodmenu)

#include <amxmodx>
#include <amxmisc>

#define PLUGIN  "LAN Modes"
#define VERSION "1.0"
#define AUTHOR  "cs16-srv"

#define MAX_MODES 9
#define TASK_VOTE 51200
#define TASK_SWITCH 51201

new const PREFIX[] = "^4[Modes]^1";

new g_modeKey[MAX_MODES][32];
new g_modeName[MAX_MODES][64];
new g_modeCount;
new g_current;

new g_configsDir[PLATFORM_MAX_PATH];
new g_stateFile[PLATFORM_MAX_PATH];

new bool:g_voteRunning;
new g_voteMenu;
new g_votes[MAX_MODES];
new Float:g_lastVote;
new bool:g_switching;

new g_pVoteDelay, g_pVoteTime, g_pVoteRatio;

public plugin_init()
{
	register_plugin(PLUGIN, VERSION, AUTHOR);

	g_pVoteDelay = create_cvar("lan_mode_vote_delay", "120", _, "Seconds after map start and between mode votes", true, 0.0);
	g_pVoteTime = create_cvar("lan_mode_vote_time", "15", _, "Duration of a mode vote in seconds", true, 5.0);
	g_pVoteRatio = create_cvar("lan_mode_vote_ratio", "0.5", _, "Share of cast votes a mode needs to win", true, 0.0, true, 1.0);

	register_concmd("amx_gamemode", "CmdMode", ADMIN_MAP, "<mode> - switch game mode (restarts the map)");
	register_concmd("amx_gamemodemenu", "CmdModeMenu", ADMIN_MAP, "- game mode menu");

	register_clcmd("say /mode", "CmdSayMode");
	register_clcmd("say /modes", "CmdSayMode");
	register_clcmd("say_team /mode", "CmdSayMode");
	register_clcmd("say /votemode", "CmdVoteMode");
	register_clcmd("say votemode", "CmdVoteMode");
	register_clcmd("say_team /votemode", "CmdVoteMode");

	get_configsdir(g_configsDir, charsmax(g_configsDir));
	new dataDir[PLATFORM_MAX_PATH];
	get_datadir(dataDir, charsmax(dataDir));
	formatex(g_stateFile, charsmax(g_stateFile), "%s/lan_mode.txt", dataDir);

	LoadModes();
	LoadCurrent();

	AddMenuItem("Game Modes", "amx_gamemodemenu", ADMIN_MAP, PLUGIN);

	// no vote right after map start
	g_lastVote = get_gametime();
}

public plugin_cfg()
{
	// delayed so it runs after the configs of the mode's own plugins
	set_task(1.0, "ExecModeCfg");
}

public ExecModeCfg()
{
	if (!g_modeCount)
		return;

	new path[PLATFORM_MAX_PATH];
	formatex(path, charsmax(path), "%s/modes/%s.cfg", g_configsDir, g_modeKey[g_current]);
	if (file_exists(path))
		server_cmd("exec ^"%s^"", path);

	server_print("[LAN Modes] Active mode: %s", g_modeName[g_current]);
}

LoadModes()
{
	new path[PLATFORM_MAX_PATH];
	formatex(path, charsmax(path), "%s/lan_modes.ini", g_configsDir);

	new f = fopen(path, "rt");
	if (!f)
	{
		log_amx("%s not found, no modes available", path);
		return;
	}

	new line[128], key[32], name[64];
	while (!feof(f) && g_modeCount < MAX_MODES)
	{
		fgets(f, line, charsmax(line));
		trim(line);
		if (!line[0] || line[0] == ';' || line[0] == '#' || (line[0] == '/' && line[1] == '/'))
			continue;

		parse(line, key, charsmax(key), name, charsmax(name));
		if (!key[0])
			continue;

		copy(g_modeKey[g_modeCount], charsmax(g_modeKey[]), key);
		copy(g_modeName[g_modeCount], charsmax(g_modeName[]), name[0] ? name : key);
		g_modeCount++;
	}
	fclose(f);
}

LoadCurrent()
{
	g_current = 0;

	new f = fopen(g_stateFile, "rt");
	if (!f)
		return;

	new key[32];
	fgets(f, key, charsmax(key));
	fclose(f);
	trim(key);

	new idx = FindMode(key);
	if (idx >= 0)
		g_current = idx;
}

FindMode(const key[])
{
	for (new i = 0; i < g_modeCount; i++)
	{
		if (equali(g_modeKey[i], key))
			return i;
	}
	return -1;
}

SwitchMode(idx)
{
	if (g_switching)
		return;

	new src[PLATFORM_MAX_PATH], dst[PLATFORM_MAX_PATH];
	formatex(src, charsmax(src), "%s/modes/%s.ini", g_configsDir, g_modeKey[idx]);
	formatex(dst, charsmax(dst), "%s/plugins-mode.ini", g_configsDir);

	new out = fopen(dst, "wt");
	if (!out)
	{
		log_amx("Cannot write %s", dst);
		return;
	}
	fprintf(out, "; generated by lan_modes.amxx - mode %s^n", g_modeKey[idx]);

	new in = fopen(src, "rt");
	if (in)
	{
		new line[256];
		while (!feof(in))
		{
			fgets(in, line, charsmax(line));
			fputs(out, line);
		}
		fclose(in);
	}
	fclose(out);

	out = fopen(g_stateFile, "wt");
	if (out)
	{
		fprintf(out, "%s^n", g_modeKey[idx]);
		fclose(out);
	}

	g_switching = true;
	client_print_color(0, print_team_default, "%s Switching to ^4%s^1 - restarting the map in 5 seconds...", PREFIX, g_modeName[idx]);
	log_amx("Switching game mode to %s", g_modeKey[idx]);
	set_task(5.0, "RestartMap", TASK_SWITCH);
}

public RestartMap()
{
	new map[64];
	get_mapname(map, charsmax(map));
	server_cmd("changelevel %s", map);
}

public CmdMode(id, level, cid)
{
	if (!cmd_access(id, level, cid, 2))
		return PLUGIN_HANDLED;

	new key[32];
	read_argv(1, key, charsmax(key));

	new idx = FindMode(key);
	if (idx < 0)
	{
		console_print(id, "Unknown mode ^"%s^". Available modes:", key);
		for (new i = 0; i < g_modeCount; i++)
			console_print(id, "  %s - %s%s", g_modeKey[i], g_modeName[i], i == g_current ? " (active)" : "");
		return PLUGIN_HANDLED;
	}

	SwitchMode(idx);
	return PLUGIN_HANDLED;
}

public CmdModeMenu(id, level, cid)
{
	if (cmd_access(id, level, cid, 1))
		ShowAdminMenu(id);
	return PLUGIN_HANDLED;
}

public CmdSayMode(id)
{
	if (access(id, ADMIN_MAP))
		ShowAdminMenu(id);
	else
		client_print_color(id, print_team_default, "%s Current mode: ^4%s^1. Type ^4/votemode^1 to vote for another one.", PREFIX, g_modeName[g_current]);
	return PLUGIN_HANDLED;
}

ShowAdminMenu(id)
{
	if (!g_modeCount)
	{
		client_print_color(id, print_team_default, "%s No modes configured.", PREFIX);
		return;
	}

	new title[96];
	formatex(title, charsmax(title), "\ySwitch game mode^n\dCurrent: %s", g_modeName[g_current]);
	new menu = menu_create(title, "AdminMenuHandler");

	new text[96], info[4];
	for (new i = 0; i < g_modeCount; i++)
	{
		formatex(text, charsmax(text), i == g_current ? "%s \d(active)" : "%s", g_modeName[i]);
		num_to_str(i, info, charsmax(info));
		menu_additem(menu, text, info);
	}
	menu_display(id, menu);
}

public AdminMenuHandler(id, menu, item)
{
	if (item >= 0 && access(id, ADMIN_MAP))
	{
		new info[4], access_, callback;
		menu_item_getinfo(menu, item, access_, info, charsmax(info), _, _, callback);
		new idx = str_to_num(info);

		new name[32];
		get_user_name(id, name, charsmax(name));
		log_amx("Admin %s switched game mode to %s", name, g_modeKey[idx]);
		SwitchMode(idx);
	}
	menu_destroy(menu);
	return PLUGIN_HANDLED;
}

public CmdVoteMode(id)
{
	if (g_modeCount < 2)
	{
		client_print_color(id, print_team_default, "%s Only one mode is configured.", PREFIX);
		return PLUGIN_HANDLED;
	}
	if (g_voteRunning || g_switching)
	{
		client_print_color(id, print_team_default, "%s A mode vote is already running.", PREFIX);
		return PLUGIN_HANDLED;
	}

	new wait = floatround(get_pcvar_float(g_pVoteDelay) - (get_gametime() - g_lastVote), floatround_ceil);
	if (wait > 0)
	{
		client_print_color(id, print_team_default, "%s Please wait ^4%d^1 seconds before starting a mode vote.", PREFIX, wait);
		return PLUGIN_HANDLED;
	}

	StartVote(id);
	return PLUGIN_HANDLED;
}

StartVote(id)
{
	g_voteRunning = true;
	arrayset(g_votes, 0, sizeof(g_votes));

	new voteTime = get_pcvar_num(g_pVoteTime);
	new title[96];
	formatex(title, charsmax(title), "\yVote game mode^n\dCurrent: %s", g_modeName[g_current]);
	g_voteMenu = menu_create(title, "VoteMenuHandler");
	menu_setprop(g_voteMenu, MPROP_PERPAGE, 0);

	new text[96], info[4];
	for (new i = 0; i < g_modeCount; i++)
	{
		formatex(text, charsmax(text), i == g_current ? "%s \d(keep)" : "%s", g_modeName[i]);
		num_to_str(i, info, charsmax(info));
		menu_additem(g_voteMenu, text, info);
	}

	new name[32];
	get_user_name(id, name, charsmax(name));
	client_print_color(0, id, "%s ^3%s^1 started a game mode vote (%d seconds).", PREFIX, name, voteTime);

	new players[MAX_PLAYERS], num;
	get_players(players, num, "ch");
	for (new i = 0; i < num; i++)
		menu_display(players[i], g_voteMenu, 0, voteTime);

	set_task(float(voteTime), "EndVote", TASK_VOTE);
}

public VoteMenuHandler(id, menu, item)
{
	if (item < 0 || !g_voteRunning)
		return PLUGIN_HANDLED;

	new info[4], access_, callback;
	menu_item_getinfo(menu, item, access_, info, charsmax(info), _, _, callback);
	new idx = str_to_num(info);
	g_votes[idx]++;

	new name[32];
	get_user_name(id, name, charsmax(name));
	client_print_color(0, id, "%s ^3%s^1 voted for ^4%s", PREFIX, name, g_modeName[idx]);
	return PLUGIN_HANDLED;
}

public EndVote()
{
	g_voteRunning = false;
	g_lastVote = get_gametime();

	new players[MAX_PLAYERS], num;
	get_players(players, num, "ch");
	for (new i = 0; i < num; i++)
		show_menu(players[i], 0, "^n", 1);
	menu_destroy(g_voteMenu);

	new total, best;
	for (new i = 0; i < g_modeCount; i++)
	{
		total += g_votes[i];
		if (g_votes[i] > g_votes[best])
			best = i;
	}

	if (!total)
	{
		client_print_color(0, print_team_default, "%s Mode vote failed: nobody voted.", PREFIX);
		return;
	}

	new percent = g_votes[best] * 100 / total;
	if (best == g_current)
	{
		client_print_color(0, print_team_default, "%s ^4%s^1 stays (%d%%).", PREFIX, g_modeName[best], percent);
		return;
	}

	if (float(g_votes[best]) / float(total) < get_pcvar_float(g_pVoteRatio))
	{
		client_print_color(0, print_team_default, "%s ^4%s^1 got only %d%% of the votes, mode stays ^4%s^1.", PREFIX, g_modeName[best], percent, g_modeName[g_current]);
		return;
	}

	client_print_color(0, print_team_default, "%s ^4%s^1 won the vote (%d%%).", PREFIX, g_modeName[best], percent);
	SwitchMode(best);
}
