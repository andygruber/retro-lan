# Network settings for both servers. Copy to server.env (not in git) and
# change there. After changing: docker compose up -d
# Without server.env the servers run as LAN servers without join password.

# 1 = LAN (default), 0 = internet. For the internet, also forward UDP 27015
# and 27016 on your router to this machine. Players connect with
#   connect <your public IP>:27015
# or find the servers in the Internet tab of the server browser.
SV_LAN=1

# Password players need to join (empty = none). Recommended for the internet.
# In the game console: password "..." before connecting. No double quotes.
SV_PASSWORD=

# FastDL: 1 = players download custom maps/sounds/models over HTTP (seconds
# instead of minutes), 0 = slow in-game download (default). Each server
# serves its files on TCP with its game port (27015, 27016); over the
# internet also forward those TCP ports.
FASTDL=0

# Address players reach this machine at, as seen by them: LAN IP, or the
# public IP / hostname for the internet. Empty = first IP of this machine.
FASTDL_HOST=
