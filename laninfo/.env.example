# Copy to .env (not in git) and adjust. After changing: docker compose up -d

# Host port of the info page. 80 = http://<host>/ ; use e.g. 8080 if 80 is taken.
LANINFO_PORT=80

# Folder with the downloads (relative to this folder or absolute).
GAMES_DIR=../games

# Any LAN_<NAME> variable overrides "<name>" from the vars in content/site.yml
# and can be used as {{name}} in all content files. Handy for things you don't
# want in git, like the Wi-Fi password. Uncomment to use:
#LAN_WIFI_SSID=RetroLAN
#LAN_WIFI_PASSWORD=supersecret
# IP of the game servers. Empty = the address players used to open this page.
#LAN_SERVER_IP=192.168.33.8
